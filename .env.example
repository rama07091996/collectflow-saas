# ==============================================================================
# CollectFlow Production & Development Environment Variables
# ==============================================================================
# Duplicate this file to .env or .env.local:
#   cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# Main pooled connection URL (Transaction pooler for serverless deployments on Vercel)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct non-pooled connection URL (Used by Prisma for migrations and schema pushing)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL of your deployed application (e.g., https://collectflow.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Clerk / NextAuth)
# ------------------------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Optional Clerk Authentication credentials (if migrating from mock auth)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"

# ------------------------------------------------------------------------------
# 4. STRIPE PAYMENT & INVOICING INTEGRATION
# ------------------------------------------------------------------------------
# Stripe API Keys (from https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51Nx..."
STRIPE_SECRET_KEY="sk_test_51Nx..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 5. QUICKBOOKS ONLINE INTEGRATION (Optional)
# ------------------------------------------------------------------------------
# From Intuit Developer Portal (https://developer.intuit.com)
QUICKBOOKS_CLIENT_ID="your-quickbooks-client-id"
QUICKBOOKS_CLIENT_SECRET="your-quickbooks-client-secret"
QUICKBOOKS_ENVIRONMENT="sandbox" # "sandbox" or "production"
QUICKBOOKS_REDIRECT_URI="https://your-domain.com/api/integrations/quickbooks/callback"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL PROVIDER (Resend / SendGrid / Postmark)
# ------------------------------------------------------------------------------
# Used for real reminder email delivery (CollectFlow includes a built-in mock dispatcher by default)
RESEND_API_KEY="re_..."
FROM_EMAIL_ADDRESS="CollectFlow Billing <billing@youragency.com>"
